<WelcomeScreen>:
    name: 'welcome'

    # Warm premium background with subtle gradient
    FloatLayout:
        canvas.before:
            # Base cream gradient
            Color:
                rgba: 0.988, 0.980, 0.973, 1
            Rectangle:
                pos: self.pos
                size: self.size
            # Top decorative arc
            Color:
                rgba: 0.345, 0.439, 0.392, 0.08
            Ellipse:
                size: self.size[0] * 1.5, self.size[0] * 0.8
                pos: self.size[0] * -0.25, self.size[1] * 0.6
            # Bottom decorative element
            Color:
                rgba: 0.949, 0.545, 0.514, 0.05
            Ellipse:
                size: self.size[0] * 1.2, self.size[0] * 0.6
                pos: self.size[0] * 0.4, self.size[1] * -0.2

    # Main content
    BoxLayout:
        orientation: 'vertical'
        padding: dp(32)
        spacing: dp(24)

        # Header Section - Logo and Branding
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.35
            spacing: dp(16)

            # Animated Logo Container
            FloatLayout:
                size_hint_y: None
                height: dp(140)

                # Logo background circle
                MDCard:
                    size_hint: None, None
                    size: dp(100), dp(100)
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    md_bg_color: 0.345, 0.439, 0.392, 1
                    radius: [dp(50),]
                    elevation: 0
                    canvas.before:
                        Color:
                            rgba: 0.345, 0.439, 0.392, 0.2
                        RoundedRectangle:
                            size: self.size[0] + dp(20), self.size[1] + dp(20)
                            pos: self.pos[0] - dp(10), self.pos[1] - dp(10)
                            radius: [dp(60),]

                    # Logo icon
                    MDIcon:
                        icon: "medical-bag"
                        theme_text_color: "Custom"
                        text_color: 0.996, 0.992, 0.988, 1
                        font_size: "48sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                # Decorative dots
                FloatLayout:
                    size_hint: None, None
                    size: dp(200), dp(60)
                    pos_hint: {"center_x": 0.5, "center_y": 0.3}

                    Widget:
                        size_hint: None, None
                        size: dp(8), dp(8)
                        pos_hint: {"x": 0.0, "center_y": 0.5}
                        canvas.before:
                            Color:
                                rgba: 0.949, 0.545, 0.514, 0.6
                            Ellipse:
                                size: self.size
                                pos: self.pos

                    Widget:
                        size_hint: None, None
                        size: dp(6), dp(6)
                        pos_hint: {"x": 0.5, "center_y": 0.5}
                        canvas.before:
                            Color:
                                rgba: 0.345, 0.439, 0.392, 0.4
                            Ellipse:
                                size: self.size
                                pos: self.pos

                    Widget:
                        size_hint: None, None
                        size: dp(8), dp(8)
                        pos_hint: {"right": 1.0, "center_y": 0.5}
                        canvas.before:
                            Color:
                                rgba: 0.949, 0.545, 0.514, 0.6
                            Ellipse:
                                size: self.size
                                pos: self.pos

            # Brand name with styling
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(4)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "VitaCare"
                    theme_text_color: "Custom"
                    text_color: 0.267, 0.349, 0.306, 1
                    font_name: "Poppins"
                    font_size: "36sp"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Your Health, Our Priority"
                    theme_text_color: "Custom"
                    text_color: 0.498, 0.494, 0.490, 1
                    font_name: "Inter"
                    font_size: "14sp"
                    halign: "center"
                    size_hint_y: None
                    height: self.texture_size[1]

        # Portal Selection Cards
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.50
            spacing: dp(16)
            padding: [0, dp(8), 0, dp(8)]

            # Patient Portal Card
            MDCard:
                orientation: 'vertical'
                size_hint: None, None
                size: dp(340), dp(200)
                pos_hint: {"center_x": 0.5}
                md_bg_color: 1, 1, 1, 1
                radius: [dp(20),]
                elevation: 0
                ripple_behavior: True
                on_release: root.manager.current = 'patient_login'
                canvas.before:
                    Color:
                        rgba: 0.345, 0.439, 0.392, 0.08
                    RoundedRectangle:
                        size: self.size[0] + dp(4), self.size[1] + dp(4)
                        pos: self.pos[0] - dp(2), self.pos[1] - dp(2)
                        radius: [dp(22),]
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [dp(20),]

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(80)
                    padding: dp(20)
                    spacing: dp(16)

                    # Icon container
                    MDCard:
                        size_hint: None, None
                        size: dp(56), dp(56)
                        md_bg_color: 0.345, 0.439, 0.392, 0.1
                        radius: [dp(16),]
                        elevation: 0

                        MDIcon:
                            icon: "account-heart"
                            theme_text_color: "Custom"
                            text_color: 0.345, 0.439, 0.392, 1
                            font_size: "28sp"
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        size_hint_x: 0.6

                        MDLabel:
                            text: "Patient Portal"
                            theme_text_color: "Custom"
                            text_color: 0.267, 0.259, 0.255, 1
                            font_name: "Poppins"
                            font_size: "18sp"
                            bold: True
                            halign: "left"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Book appointments, view records"
                            theme_text_color: "Custom"
                            text_color: 0.498, 0.494, 0.490, 1
                            font_name: "Inter"
                            font_size: "12sp"
                            halign: "left"
                            size_hint_y: None
                            height: self.texture_size[1]

                    Widget:
                        size_hint_x: 0.1

                    # Arrow indicator
                    MDIcon:
                        icon: "chevron-right"
                        theme_text_color: "Custom"
                        text_color: 0.737, 0.729, 0.725, 1
                        font_size: "24sp"
                        size_hint_x: 0.1

                Widget:
                    size_hint_y: None
                    height: dp(1)
                    canvas.before:
                        Color:
                            rgba: 0.737, 0.729, 0.725, 0.3
                        Line:
                            points: dp(20), 0, self.width - dp(20), 0
                            width: dp(1)

                MDLabel:
                    text: "Access your personal health dashboard, schedule appointments with your preferred doctors, and manage prescriptions from anywhere."
                    theme_text_color: "Custom"
                    text_color: 0.498, 0.494, 0.490, 1
                    font_name: "Inter"
                    font_size: "12sp"
                    halign: "center"
                    valign: "top"
                    padding: dp(20), dp(8)

                # Enter button
                MDRaisedButton:
                    text: "Enter Portal"
                    md_bg_color: 0.345, 0.439, 0.392, 1
                    text_color: 0.996, 0.992, 0.988, 1
                    font_name: "Poppins"
                    font_size: "14sp"
                    bold: True
                    size_hint_y: None
                    height: dp(44)
                    elevation: 0
                    radius: [dp(22),]
                    pos_hint: {"center_x": 0.5}
                    on_release: root.manager.current = 'patient_login'

            # Doctor Portal Card
            MDCard:
                orientation: 'vertical'
                size_hint: None, None
                size: dp(340), dp(200)
                pos_hint: {"center_x": 0.5}
                md_bg_color: 1, 1, 1, 1
                radius: [dp(20),]
                elevation: 0
                ripple_behavior: True
                on_release: root.manager.current = 'doctor_login'
                canvas.before:
                    Color:
                        rgba: 0.949, 0.545, 0.514, 0.08
                    RoundedRectangle:
                        size: self.size[0] + dp(4), self.size[1] + dp(4)
                        pos: self.pos[0] - dp(2), self.pos[1] - dp(2)
                        radius: [dp(22),]
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [dp(20),]

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(80)
                    padding: dp(20)
                    spacing: dp(16)

                    # Icon container
                    MDCard:
                        size_hint: None, None
                        size: dp(56), dp(56)
                        md_bg_color: 0.949, 0.545, 0.514, 0.1
                        radius: [dp(16),]
                        elevation: 0

                        MDIcon:
                            icon: "doctor"
                            theme_text_color: "Custom"
                            text_color: 0.949, 0.545, 0.514, 1
                            font_size: "28sp"
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        size_hint_x: 0.6

                        MDLabel:
                            text: "Doctor Portal"
                            theme_text_color: "Custom"
                            text_color: 0.267, 0.259, 0.255, 1
                            font_name: "Poppins"
                            font_size: "18sp"
                            bold: True
                            halign: "left"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Manage your practice"
                            theme_text_color: "Custom"
                            text_color: 0.498, 0.494, 0.490, 1
                            font_name: "Inter"
                            font_size: "12sp"
                            halign: "left"
                            size_hint_y: None
                            height: self.texture_size[1]

                    Widget:
                        size_hint_x: 0.1

                    # Arrow indicator
                    MDIcon:
                        icon: "chevron-right"
                        theme_text_color: "Custom"
                        text_color: 0.737, 0.729, 0.725, 1
                        font_size: "24sp"
                        size_hint_x: 0.1

                Widget:
                    size_hint_y: None
                    height: dp(1)
                    canvas.before:
                        Color:
                            rgba: 0.737, 0.729, 0.725, 0.3
                        Line:
                            points: dp(20), 0, self.width - dp(20), 0
                            width: dp(1)

                MDLabel:
                    text: "View your daily schedule, access patient records, add consultations, and provide prescriptions — all in one place."
                    theme_text_color: "Custom"
                    text_color: 0.498, 0.494, 0.490, 1
                    font_name: "Inter"
                    font_size: "12sp"
                    halign: "center"
                    valign: "top"
                    padding: dp(20), dp(8)

                # Enter button
                MDRaisedButton:
                    text: "Enter Portal"
                    md_bg_color: 0.949, 0.545, 0.514, 1
                    text_color: 0.996, 0.992, 0.988, 1
                    font_name: "Poppins"
                    font_size: "14sp"
                    bold: True
                    size_hint_y: None
                    height: dp(44)
                    elevation: 0
                    radius: [dp(22),]
                    pos_hint: {"center_x": 0.5}
                    on_release: root.manager.current = 'doctor_login'

        # Footer
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.15
            spacing: dp(8)

            # Trust badges
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(24)
                spacing: dp(24)
                padding: [dp(40), 0]

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(6)
                    size_hint_x: None
                    width: self.minimum_width

                    MDIcon:
                        icon: "shield-check"
                        theme_text_color: "Custom"
                        text_color: 0.345, 0.439, 0.392, 1
                        font_size: "16sp"
                        size_hint_x: None
                        width: dp(20)

                    MDLabel:
                        text: "Secure"
                        theme_text_color: "Custom"
                        text_color: 0.498, 0.494, 0.490, 1
                        font_name: "Inter"
                        font_size: "11sp"
                        size_hint_x: None
                        width: self.texture_size[0]

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(6)
                    size_hint_x: None
                    width: self.minimum_width

                    MDIcon:
                        icon: "clock-outline"
                        theme_text_color: "Custom"
                        text_color: 0.345, 0.439, 0.392, 1
                        font_size: "16sp"
                        size_hint_x: None
                        width: dp(20)

                    MDLabel:
                        text: "24/7 Access"
                        theme_text_color: "Custom"
                        text_color: 0.498, 0.494, 0.490, 1
                        font_name: "Inter"
                        font_size: "11sp"
                        size_hint_x: None
                        width: self.texture_size[0]

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(6)
                    size_hint_x: None
                    width: self.minimum_width

                    MDIcon:
                        icon: "doctor"
                        theme_text_color: "Custom"
                        text_color: 0.345, 0.439, 0.392, 1
                        font_size: "16sp"
                        size_hint_x: None
                        width: dp(20)

                    MDLabel:
                        text: "Verified Doctors"
                        theme_text_color: "Custom"
                        text_color: 0.498, 0.494, 0.490, 1
                        font_name: "Inter"
                        font_size: "11sp"
                        size_hint_x: None
                        width: self.texture_size[0]

            MDLabel:
                text: "© 2024 VitaCare Medical Systems"
                theme_text_color: "Custom"
                text_color: 0.737, 0.729, 0.725, 1
                font_name: "Inter"
                font_size: "10sp"
                halign: "center"