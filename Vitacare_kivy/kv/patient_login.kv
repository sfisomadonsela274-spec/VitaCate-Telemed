<PatientLoginScreen>:
    name: "patient_login"

    # Background with subtle decorative elements
    FloatLayout:
        canvas.before:
            # Warm cream base
            Color:
                rgba: 0.988, 0.980, 0.973, 1
            Rectangle:
                pos: self.pos
                size: self.size
            # Top-right decorative arc
            Color:
                rgba: 0.345, 0.439, 0.392, 0.06
            Ellipse:
                size: self.size[0] * 1.2, self.size[0] * 0.7
                pos: self.size[0] * 0.5, self.size[1] * 0.7
            # Bottom-left decorative arc
            Color:
                rgba: 0.949, 0.545, 0.514, 0.04
            Ellipse:
                size: self.size[0] * 0.8, self.size[0] * 0.5
                pos: self.size[0] * -0.3, self.size[1] * -0.1

    BoxLayout:
        orientation: 'vertical'
        padding: dp(24)
        spacing: dp(20)

        # Back button and header
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.15
            spacing: dp(16)

            # Navigation row
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(48)

                # Back button
                MDIconButton:
                    icon: "arrow-left"
                    theme_text_color: "Custom"
                    text_color: 0.345, 0.439, 0.392, 1
                    pos_hint: {"x": 0, "center_y": 0.5}
                    radius: [12,]
                    on_release: root.on_back_press()

                Widget:
                    size_hint_x: 1

            # Welcome text
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(4)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "Welcome Back"
                    theme_text_color: "Custom"
                    text_color: 0.267, 0.349, 0.306, 1
                    font_name: "Poppins"
                    font_size: "28sp"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Sign in to access your health dashboard"
                    theme_text_color: "Custom"
                    text_color: 0.498, 0.494, 0.490, 1
                    font_name: "Inter"
                    font_size: "13sp"
                    halign: "center"
                    size_hint_y: None
                    height: self.texture_size[1]

        # Login form card
        MDCard:
            orientation: 'vertical'
            size_hint: None, None
            size: dp(340), dp(380)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            md_bg_color: 1, 1, 1, 1
            radius: [dp(24),]
            elevation: 0
            padding: dp(24)
            spacing: dp(20)
            canvas.before:
                # Subtle shadow
                Color:
                    rgba: 0.267, 0.259, 0.255, 0.06
                RoundedRectangle:
                    size: self.size[0] + dp(16), self.size[1] + dp(16)
                    pos: self.pos[0] - dp(8), self.pos[1] - dp(8)
                    radius: [dp(28),]
                # Card
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [dp(24),]
                # Top accent line
                Color:
                    rgba: 0.345, 0.439, 0.392, 0.6
                RoundedRectangle:
                    size: self.size[0], dp(3)
                    pos: self.pos[0], self.pos[1] + self.size[1] - dp(3)
                    radius: [dp(3), dp(3), 0, 0]

            # Email field with icon
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(8)
                size_hint_y: None
                height: dp(90)

                MDLabel:
                    text: "Email"
                    theme_text_color: "Custom"
                    text_color: 0.498, 0.494, 0.490, 1
                    font_name: "Inter"
                    font_size: "12sp"
                    halign: "left"
                    size_hint_y: None
                    height: self.texture_size[1]

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(52)
                    spacing: dp(12)
                    padding: [dp(16), 0]
                    canvas.before:
                        Color:
                            rgba: 0.737, 0.729, 0.725, 0.5
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [dp(12),]
                        Color:
                            rgba: 0.345, 0.439, 0.392, 0.8
                        RoundedRectangle:
                            size: self.size[0], dp(2)
                            pos: self.pos[0], self.pos[1]
                            radius: [dp(12), dp(12), 0, 0]

                    MDIcon:
                        icon: "email-outline"
                        theme_text_color: "Custom"
                        text_color: 0.345, 0.439, 0.392, 1
                        font_size: "20sp"
                        size_hint_x: None
                        width: dp(24)

                    MDTextField:
                        id: email_input
                        hint_text: "patient@example.com"
                        mode: "rectangle"
                        size_hint_x: 1
                        icon_left: ""
                        text_color: 0.267, 0.259, 0.255, 1
                        hint_text_color: 0.737, 0.729, 0.725, 1
                        font_name: "Inter"
                        font_size: "14sp"
                        line_color_focus: 0.345, 0.439, 0.392, 1
                        on_text_validate: password_input.focus = True

            # Password field with icon
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(8)
                size_hint_y: None
                height: dp(90)

                MDLabel:
                    text: "Password"
                    theme_text_color: "Custom"
                    text_color: 0.498, 0.494, 0.490, 1
                    font_name: "Inter"
                    font_size: "12sp"
                    halign: "left"
                    size_hint_y: None
                    height: self.texture_size[1]

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(52)
                    spacing: dp(12)
                    padding: [dp(16), 0]
                    canvas.before:
                        Color:
                            rgba: 0.737, 0.729, 0.725, 0.5
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [dp(12),]
                        Color:
                            rgba: 0.345, 0.439, 0.392, 0.8
                        RoundedRectangle:
                            size: self.size[0], dp(2)
                            pos: self.pos[0], self.pos[1]
                            radius: [dp(12), dp(12), 0, 0]

                    MDIcon:
                        icon: "lock-outline"
                        theme_text_color: "Custom"
                        text_color: 0.345, 0.439, 0.392, 1
                        font_size: "20sp"
                        size_hint_x: None
                        width: dp(24)

                    MDTextField:
                        id: password_input
                        hint_text: "Enter your password"
                        mode: "rectangle"
                        size_hint_x: 1
                        password: True
                        icon_left: ""
                        text_color: 0.267, 0.259, 0.255, 1
                        hint_text_color: 0.737, 0.729, 0.725, 1
                        font_name: "Inter"
                        font_size: "14sp"
                        line_color_focus: 0.345, 0.439, 0.392, 1
                        on_text_validate: root.login_user()

                    MDIconButton:
                        icon: "eye-off"
                        theme_text_color: "Custom"
                        text_color: 0.737, 0.729, 0.725, 1
                        size_hint_x: None
                        width: dp(32)
                        radius: [12,]
                        on_release:
                            password_input.password = not password_input.password
                            self.icon = "eye" if not password_input.password else "eye-off"

            # Forgot password link
            MDTextButton:
                text: "Forgot Password?"
                theme_text_color: "Custom"
                text_color: 0.345, 0.439, 0.392, 1
                font_name: "Inter"
                font_size: "12sp"
                halign: "right"
                size_hint_y: None
                height: dp(32)
                on_release: app.root.current = "forgot_password_email"

            # Login button
            MDRaisedButton:
                id: login_button
                text: "Sign In"
                md_bg_color: 0.345, 0.439, 0.392, 1
                text_color: 0.996, 0.992, 0.988, 1
                font_name: "Poppins"
                font_size: "15sp"
                bold: True
                size_hint_y: None
                height: dp(52)
                elevation: 0
                radius: [dp(26),]
                on_release: root.login_user()
                canvas.before:
                    Color:
                        rgba: 0.345, 0.439, 0.392, 0.15
                    RoundedRectangle:
                        size: self.size[0] + dp(4), self.size[1] + dp(4)
                        pos: self.pos[0] - dp(2), self.pos[1] - dp(2)
                        radius: [dp(28),]

            # Divider with text
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(32)
                spacing: dp(16)

                Widget:
                    canvas.before:
                        Color:
                            rgba: 0.737, 0.729, 0.725, 0.5
                        Line:
                            points: 0, self.height/2, self.width, self.height/2
                            width: dp(1)

                MDLabel:
                    text: "or"
                    theme_text_color: "Custom"
                    text_color: 0.737, 0.729, 0.725, 1
                    font_name: "Inter"
                    font_size: "12sp"
                    halign: "center"
                    size_hint_x: None
                    width: dp(32)

                Widget:
                    canvas.before:
                        Color:
                            rgba: 0.737, 0.729, 0.725, 0.5
                        Line:
                            points: 0, self.height/2, self.width, self.height/2
                            width: dp(1)

            # Sign up link
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(32)
                halign: "center"

                MDLabel:
                    text: "Don't have an account?"
                    theme_text_color: "Custom"
                    text_color: 0.498, 0.494, 0.490, 1
                    font_name: "Inter"
                    font_size: "12sp"
                    halign: "right"
                    size_hint_x: None
                    width: dp(130)

                MDTextButton:
                    text: "Sign Up"
                    theme_text_color: "Custom"
                    text_color: 0.949, 0.545, 0.514, 1
                    font_name: "Poppins"
                    font_size: "12sp"
                    bold: True
                    halign: "left"
                    size_hint_x: None
                    width: dp(60)
                    on_release: app.root.current = "sign_up"

        # Footer
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.1
            spacing: dp(8)

            MDLabel:
                text: "By signing in, you agree to our Terms of Service and Privacy Policy"
                theme_text_color: "Custom"
                text_color: 0.737, 0.729, 0.725, 1
                font_name: "Inter"
                font_size: "10sp"
                halign: "center"