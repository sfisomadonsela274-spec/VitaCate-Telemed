# VitaCare Design System
# "Soft Clinical Luxury" - Warm, Premium, Calming

# =============================================================================
# CUSTOM COLORS - Reusable color definitions
# =============================================================================

# Primary Colors - Sage Green (Trust, Health, Calm)
#:set primary_sage (0.345, 0.439, 0.392, 1)
#:set primary_sage_light (0.498, 0.612, 0.561, 1)
#:set primary_sage_dark (0.267, 0.349, 0.306, 1)

# Secondary Colors - Warm Blush (Approachable, Human)
#:set secondary_blush (0.949, 0.545, 0.514, 1)
#:set secondary_blush_light (0.976, 0.769, 0.749, 1)
#:set secondary_blush_dark (0.831, 0.341, 0.314, 1)

# Neutral Colors - Warm Grays
#:set neutral_cream (0.982, 0.973, 0.965, 1)
#:set neutral_warm_white (0.996, 0.992, 0.988, 1)
#:set neutral_warm_gray (0.737, 0.722, 0.714, 1)
#:set neutral_deep_gray (0.341, 0.333, 0.329, 1)

# Accent Colors
#:set accent_teal (0.365, 0.651, 0.620, 1)
#:set accent_gold (0.808, 0.686, 0.424, 1)
#:set accent_lavender (0.624, 0.565, 0.776, 1)

# =============================================================================
# TYPOGRAPHY SCALE
# =============================================================================

# =============================================================================
# SPACING SYSTEM - 4pt Grid
# =============================================================================

# =============================================================================
# ANIMATION TIMINGS
# =============================================================================

# =============================================================================
# CARD STYLES
# =============================================================================

# Premium Card with subtle shadow effect
<PremiumCard@MDCard>:
    orientation: 'vertical'
    size_hint: None, None
    pos_hint: {"center_x": 0.5}
    elevation: 0
    padding: dp(20)
    spacing: dp(16)
    md_bg_color: 1, 1, 1, 1
    radius: [dp(20),]
    canvas.after:
        Color:
            rgba: 0, 0, 0, 0.08
        Rectangle:
            size: self.size[0] + dp(8), self.size[1] + dp(8)
            pos: self.pos[0] - dp(4), self.pos[1] - dp(4)

# Glass Card - For overlays and special sections
<GlassCard@MDCard>:
    orientation: 'vertical'
    size_hint: None, None
    pos_hint: {"center_x": 0.5}
    elevation: 0
    padding: dp(20)
    spacing: dp(16)
    md_bg_color: 0.996, 0.992, 0.988, 0.9
    radius: [dp(20),]
    canvas.after:
        Color:
            rgba: 0, 0, 0, 0.05
        Rectangle:
            size: self.size[0] + dp(6), self.size[1] + dp(6)
            pos: self.pos[0] - dp(3), self.pos[1] - dp(3)

# =============================================================================
# BUTTON STYLES
# =============================================================================

# Primary Button - Sage Green
<PrimaryButton@MDRaisedButton>:
    size_hint_y: None
    height: dp(52)
    md_bg_color: 0.345, 0.439, 0.392, 1
    text_color: 0.996, 0.992, 0.988, 1
    font_name: "Poppins"
    font_size: "15sp"
    bold: True
    elevation: 0
    radius: [dp(26),]

# Secondary Button - Outlined
<SecondaryButton@MDRoundFlatButton>:
    size_hint_y: None
    height: dp(52)
    md_bg_color: 0, 0, 0, 0
    text_color: 0.345, 0.439, 0.392, 1
    font_name: "Poppins"
    font_size: "15sp"
    bold: True
    elevation: 0
    radius: [dp(26),]
    line_width: dp(1.5)
    line_color: 0.345, 0.439, 0.392, 1

# Coral Accent Button
<CoralButton@MDRaisedButton>:
    size_hint_y: None
    height: dp(52)
    md_bg_color: 0.949, 0.545, 0.514, 1
    text_color: 0.996, 0.992, 0.988, 1
    font_name: "Poppins"
    font_size: "15sp"
    bold: True
    elevation: 0
    radius: [dp(26),]

# Icon Button - Circular
<IconButton@MDIconButton>:
    size_hint: None, None
    size: dp(48), dp(48)
    md_bg_color: 0.345, 0.439, 0.392, 0.1
    icon_size: dp(24)
    radius: [dp(24),]
    elevation: 0

# =============================================================================
# INPUT FIELD STYLES
# =============================================================================

# Premium Text Field
<PremiumTextField@MDTextField>:
    mode: "rectangle"
    text_color: 0.267, 0.259, 0.255, 1
    hint_text_color: 0.737, 0.729, 0.725, 1
    font_name: "Inter"
    font_size: "15sp"
    line_color_normal: 0.737, 0.729, 0.725, 1
    line_color_focus: 0.345, 0.439, 0.392, 1
    line_width: dp(1.5)
    padding: [dp(16), dp(12), dp(16), dp(12)]
    radius: [dp(12),]

# =============================================================================
# SCREEN CONTAINER
# =============================================================================

<PremiumScreen@MDScreen>:
    canvas.before:
        # Warm cream background
        Color:
            rgba: 0.982, 0.973, 0.965, 1
        Rectangle:
            pos: self.pos
            size: self.size
    canvas.after:
        # Subtle shadow effect
        Color:
            rgba: 0, 0, 0, 0.05
        Rectangle:
            size: self.size[0] + dp(10), self.size[1] + dp(10)
            pos: self.pos[0] - dp(5), self.pos[1] - dp(5)